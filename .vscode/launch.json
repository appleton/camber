{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug go test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Debug: attach to Helper",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 21370,
      "host": "127.0.0.1"
    },
    {
      "name": "Launch Desktop Assistant",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-F",
        "@camber/desktop-assistant",
        "dev",
        "--config",
        "{\"identifier\":\"io.github.appleton.camber.dev\",\"productName\":\"Camber Dev\",\"mainBinaryName\":\"Camber Dev\"}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "vscode-assistant-dev",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/ui/apps/vscode-assistant",
        "--disable-extension=appleton.acp-assistant",
        "--profile=local-development",
        "${workspaceFolder}/../camber-books-api-demo/",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/ui/apps/vscode-assistant/dist/**/*.{js,cjs}"
      ]
    },
    {
      "name": "Launch Extension (with my profile)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "vscode-assistant-dev",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/ui/apps/vscode-assistant",
        "--disable-extension=appleton.acp-assistant",
        "${workspaceFolder}/../camber-books-api-demo",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/ui/apps/vscode-assistant/dist/**/*.{js,cjs}"
      ],
      "env": {
        "HTTPS_PROXY": "${env:HTTPS_PROXY}",
        "HTTP_PROXY": "${env:HTTP_PROXY}"
      },
      "sourceMaps": true
    }
  ]
}
