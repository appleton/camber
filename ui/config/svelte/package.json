{
  "name": "@camber/svelte-config",
  "version": "2.3.53",
  "private": true,
  "description": "Common svelte configuration",
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "tsc --project tsconfig.check.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "prepare": "turbo build --output-logs errors-only",
    "prepublishOnly": "turbo build"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@camber/prettier-config",
  "dependencies": {
    "@melt-ui/pp": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:"
  },
  "devDependencies": {
    "@camber/eslint-config": "workspace:*",
    "@camber/prettier-config": "workspace:*",
    "@camber/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  }
}
