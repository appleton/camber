{
  "name": "@camber/remote-client",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-side client for camber-helper's remote access WebSocket: JSON-RPC transport, sequenced session-event gating, device-token auth recovery, and the webview host adapter used by the mobile remote (and by any future surface that talks to a remote helper).",
  "repository": {
    "type": "git",
    "url": "https://github.com/appleton/camber"
  },
  "author": {
    "name": "Andy Appleton",
    "url": "https://github.com/appleton"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "tsc --project tsconfig.check.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit"
  },
  "prettier": "@camber/prettier-config",
  "dependencies": {
    "@camber/rpc": "workspace:*"
  },
  "devDependencies": {
    "@camber/eslint-config": "workspace:*",
    "@camber/prettier-config": "workspace:*",
    "@camber/tsconfig": "workspace:*",
    "@camber/vite-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
