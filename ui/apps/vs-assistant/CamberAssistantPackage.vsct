<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<!--  This is the file that defines the actual layout and type of the commands.
        It is divided in different sections (e.g. command definition, command
        placement, ...), with each defining a specific set of properties.
        See the comment before each section for more details about how to
        use it. -->

	<!--  The VSCT compiler (the tool that translates this file into the binary
        format that VisualStudio will consume) has the ability to run a preprocessor
        on the vsct file; this preprocessor is (usually) the C++ preprocessor, so
        it is possible to define includes and macros with the same syntax used
        in C++ files. Using this ability of the compiler here, we include some files
        defining some of the constants that we will use inside the file. -->

	<!--This is the file that defines the IDs for all the commands exposed by VisualStudio. -->
	<Extern href="stdidcmd.h"/>

	<!--This header contains the command ids for the menus provided by the shell. -->
	<Extern href="vsshlids.h"/>

	<!--Built-in VS image catalog (KnownMonikers) used for the sidebar toolbar icons. -->
	<Extern href="KnownImageIds.vsct"/>

	<!--The Commands section is where commands, menus, and menu groups are defined.
      This section uses a Guid to identify the package that provides the command defined inside it. -->
	<Commands package="guidCamberAssistantPackage">
		<Groups>
			<Group guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSubMenuGroupId" priority="0x0000">
				<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSubMenuId"/>
			</Group>
			<Group guid="guidCamberAssistantPackageHelpCmdSet" id="CamberSubMenuGroupId" priority="0x0000">
				<Parent guid="guidCamberAssistantPackageHelpCmdSet" id="CamberSubMenuId"/>
			</Group>
			<!-- Group hosting the actions shown on the sidebar tool window's toolbar. -->
			<Group guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSidebarToolbarGroup" priority="0x0000">
				<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSidebarToolbar"/>
			</Group>
		</Groups>

		<Menus>
			<Menu guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSubMenuId" priority="0x0100" type="Menu">
				<Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_OTHER2"/>
				<Strings>
					<ButtonText>Camber Assistant</ButtonText>
					<CommandName>Camber Assistant</CommandName>
				</Strings>
			</Menu>
			<Menu guid="guidCamberAssistantPackageHelpCmdSet" id="CamberSubMenuId" priority="0x0100" type="Menu">
				<Parent guid="guidSHLMainMenu" id="IDG_VS_HELP_SUPPORT"/>
				<Strings>
					<ButtonText>Camber Assistant</ButtonText>
					<CommandName>Camber Assistant</CommandName>
				</Strings>
			</Menu>
			<!-- Toolbar attached (in C#) to the sidebar tool window via ToolWindowPane.ToolBar. -->
			<Menu guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSidebarToolbar" priority="0x0000" type="ToolWindowToolbar">
				<Strings>
					<ButtonText>Camber Assistant</ButtonText>
					<CommandName>Camber Assistant Toolbar</CommandName>
				</Strings>
			</Menu>
		</Menus>

		<!--Buttons section. -->
		<!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
		<Buttons>
			<!--To define a menu group you have to specify its ID, the parent menu and its display priority.
          The command is visible and enabled by default. If you need to change the visibility, status, etc, you can use
          the CommandFlag node.
          You can add more than one CommandFlag node e.g.:
              <CommandFlag>DefaultInvisible</CommandFlag>
              <CommandFlag>DynamicVisibility</CommandFlag>
          If you do not want an image next to your command, remove the Icon node /> -->
			<Button guid="guidCamberAssistantPackageToolsCmdSet" id="NewConversationCamberCommandId" priority="0x0101" type="Button">
				<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSubMenuGroupId"/>
				<Icon guid="ImageCatalogGuid" id="Add" />
				<CommandFlag>IconIsMoniker</CommandFlag>
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>New Conversation</ButtonText>
					<LocCanonicalName>.CamberAssistant.NewConversation</LocCanonicalName>
				</Strings>
			</Button>
			<!-- Settings action on the sidebar tool window toolbar (mirrors VS Code's
			     view/title Settings button). Opens the Camber options page. -->
			<Button guid="guidCamberAssistantPackageToolsCmdSet" id="OpenSettingsCommandId" priority="0x0001" type="Button">
				<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSidebarToolbarGroup"/>
				<Icon guid="ImageCatalogGuid" id="Settings" />
				<CommandFlag>IconIsMoniker</CommandFlag>
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>Settings</ButtonText>
					<LocCanonicalName>.CamberAssistant.OpenSettings</LocCanonicalName>
				</Strings>
			</Button>
			<Button guid="guidCamberAssistantPackageToolsCmdSet" id="FocusInputCamberCommandId" priority="0x0106" type="Button">
				<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSubMenuGroupId"/>
				<Strings>
					<ButtonText>Focus Input</ButtonText>
					<LocCanonicalName>.CamberAssistant.FocusInput</LocCanonicalName>
				</Strings>
				<CommandFlag>DynamicVisibility</CommandFlag>
			</Button>
			<Button guid="guidCamberAssistantPackageToolsCmdSet" id="TogglePlanModeCamberCommandId" priority="0x0107" type="Button">
				<Strings>
					<ButtonText>Toggle Plan/Build Mode</ButtonText>
					<LocCanonicalName>.CamberAssistant.TogglePlanMode</LocCanonicalName>
				</Strings>
			</Button>
			<Button guid="guidCamberAssistantPackageToolsCmdSet" id="OpenPermissionSettingsCommandId" priority="0x010E" type="Button">
				<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSubMenuGroupId"/>
				<Strings>
					<ButtonText>Open Permission Settings</ButtonText>
					<LocCanonicalName>.CamberAssistant.OpenPermissionSettings</LocCanonicalName>
				</Strings>
				<CommandFlag>DynamicVisibility</CommandFlag>
			</Button>
			<!-- Mirrors VS Code's camber.resetConfiguration command. -->
			<Button guid="guidCamberAssistantPackageToolsCmdSet" id="ResetConfigurationCommandId" priority="0x0111" type="Button">
				<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSubMenuGroupId"/>
				<Strings>
					<ButtonText>Reset Configuration</ButtonText>
					<LocCanonicalName>.CamberAssistant.ResetConfiguration</LocCanonicalName>
				</Strings>
				<CommandFlag>DynamicVisibility</CommandFlag>
			</Button>
			<Button guid="guidCamberAssistantPackageHelpCmdSet" id="CamberAssistantDevToolsCommandId" priority="0x1000" type="Button">
				<Parent guid="guidCamberAssistantPackageHelpCmdSet" id="CamberSubMenuGroupId"/>
				<Strings>
					<ButtonText>Open Assistant Dev Tools</ButtonText>
					<LocCanonicalName>.CamberAssistant.OpenAssistantDevTools</LocCanonicalName>
				</Strings>
				<CommandFlag>DynamicVisibility</CommandFlag>
			</Button>
			<Button guid="guidCamberAssistantPackageHelpCmdSet" id="CamberTaskDevToolsCommandId" priority="0x1000" type="Button">
				<Parent guid="guidCamberAssistantPackageHelpCmdSet" id="CamberSubMenuGroupId"/>
				<Strings>
					<ButtonText>Open Task Dev Tools</ButtonText>
					<LocCanonicalName>.CamberAssistant.OpenTaskDevTools</LocCanonicalName>
				</Strings>
				<CommandFlag>DynamicVisibility</CommandFlag>
			</Button>
			<Button guid="guidCamberAssistantPackageHelpCmdSet" id="CamberHelperDebugLogCommandId" priority="0x1000" type="Button">
				<Parent guid="guidCamberAssistantPackageHelpCmdSet" id="CamberSubMenuGroupId"/>
				<Strings>
					<ButtonText>Open Helper Debug Log</ButtonText>
					<LocCanonicalName>.CamberAssistant.OpenHelperDebugLog</LocCanonicalName>
				</Strings>
				<CommandFlag>DynamicVisibility</CommandFlag>
			</Button>
			<Button guid="guidCamberAssistantPackageHelpCmdSet" id="CamberHelperProtocolLogCommandId" priority="0x1000" type="Button">
				<Parent guid="guidCamberAssistantPackageHelpCmdSet" id="CamberSubMenuGroupId"/>
				<Strings>
					<ButtonText>Copy Helper Protocol Log to Clipboard</ButtonText>
					<LocCanonicalName>.CamberAssistant.CopyHelperProtocolLog</LocCanonicalName>
				</Strings>
				<CommandFlag>DynamicVisibility</CommandFlag>
			</Button>
		</Buttons>
	</Commands>

	<!-- Surface New Conversation on the sidebar tool window toolbar as well as in the
	     Tools submenu; both placements drive the same NewConversationCommand handler. -->
	<CommandPlacements>
		<CommandPlacement guid="guidCamberAssistantPackageToolsCmdSet" id="NewConversationCamberCommandId" priority="0x0000">
			<Parent guid="guidCamberAssistantPackageToolsCmdSet" id="CamberSidebarToolbarGroup"/>
		</CommandPlacement>
	</CommandPlacements>

	<KeyBindings>
		<KeyBinding guid="guidCamberAssistantPackageToolsCmdSet"
					id="FocusInputCamberCommandId"
					editor="guidVSStd97"
					key1="E" mod1="Control"
					key2="P" mod2="Control" />
		<KeyBinding guid="guidCamberAssistantPackageToolsCmdSet"
					id="TogglePlanModeCamberCommandId"
					editor="guidVSStd97"
					key1="E" mod1="Control"
					key2="M" mod2="Control" />
	</KeyBindings>

	<Symbols>
		<!-- This is the package guid. -->
		<GuidSymbol name="guidCamberAssistantPackage" value="{1dc0dcb4-146c-42bc-b922-0975daea8e56}" />

		<!-- This is the guid used to group the tools menu commands together -->
		<GuidSymbol name="guidCamberAssistantPackageToolsCmdSet" value="{08c5ffe7-6ce9-4f03-afc5-39cf2c5cba53}">
			<IDSymbol name="CamberSubMenuId" value="0x0010" />
			<IDSymbol name="CamberSubMenuGroupId" value="0x0020" />
			<IDSymbol name="CamberSidebarToolbar" value="0x0030" />
			<IDSymbol name="CamberSidebarToolbarGroup" value="0x0031" />
			<IDSymbol name="NewConversationCamberCommandId" value="0x0101" />
			<IDSymbol name="FocusInputCamberCommandId" value="0x0106"/>
			<IDSymbol name="OpenPermissionSettingsCommandId" value="0x0140" />
			<IDSymbol name="TogglePlanModeCamberCommandId" value="0x0150" />
			<IDSymbol name="OpenSettingsCommandId" value="0x0160" />
			<IDSymbol name="ResetConfigurationCommandId" value="0x0170" />
		</GuidSymbol>

		<!-- This is the guid used to group the help menu commands together -->
		<GuidSymbol name="guidCamberAssistantPackageHelpCmdSet" value="{2858B5DD-FD1D-4586-BEFA-FD8F778FA463}">
			<IDSymbol name="CamberSubMenuId" value="0x0010" />
			<IDSymbol name="CamberSubMenuGroupId" value="0x0020" />
			<IDSymbol name="CamberAssistantDevToolsCommandId" value="0x0100" />
			<IDSymbol name="CamberTaskDevToolsCommandId" value="0x0110" />
			<IDSymbol name="CamberHelperDebugLogCommandId" value="0x0120" />
			<IDSymbol name="CamberHelperProtocolLogCommandId" value="0x0130" />
		</GuidSymbol>
	</Symbols>
</CommandTable>
