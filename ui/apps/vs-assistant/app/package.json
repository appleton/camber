{
  "name": "@camber/vs-assistant",
  "version": "1.4.0",
  "private": true,
  "description": "The Camber app to run in a tool window in Visual Studio.",
  "repository": {
    "type": "git",
    "url": "https://github.com/appleton/camber"
  },
  "author": {
    "name": "Andy Appleton",
    "url": "https://github.com/appleton"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:format": "prettier . --check --cache --ignore-path ../../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "svelte-check --tsconfig tsconfig.check.json --fail-on-warnings --compiler-warnings \"state_referenced_locally:ignore,a11y_no_static_element_interactions:ignore\"",
    "dev": "vite",
    "download:binaries": "../scripts/copy_helper.sh",
    "fix:format": "prettier . --write --cache --ignore-path ../../../.gitignore",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "make-release-manifest": "tsx ../scripts/make-release-manifest.ts"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@camber/prettier-config",
  "dependencies": {
    "@camber/assistant": "workspace:*",
    "@camber/components": "workspace:*",
    "@camber/features": "workspace:*",
    "@camber/helperapi": "workspace:*",
    "@camber/lib": "workspace:*",
    "@camber/rpc": "workspace:*"
  },
  "devDependencies": {
    "@camber/eslint-config": "workspace:*",
    "@camber/prettier-config": "workspace:*",
    "@camber/svelte-config": "workspace:*",
    "@camber/tailwind-config": "workspace:*",
    "@camber/tsconfig": "workspace:*",
    "@camber/vite-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
