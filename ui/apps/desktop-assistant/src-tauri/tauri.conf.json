{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Camber",
  "mainBinaryName": "Camber",
  "version": "0.0.0",
  "identifier": "io.github.appleton.camber",
  "build": {
    "runner": "mbx",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "beforeBundleCommand": "node scripts/set-macos-build-sdk.mjs",
    "devUrl": "http://localhost:5177",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Camber",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        },
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../dist-isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "licenseFile": "../../../../LICENSE",
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/camber-helper",
      "binaries/camber-mlx-sidecar",
      "binaries/camber-whisper-server"
    ],
    "resources": {
      "../../../../LICENSE": "LICENSE",
      "Credits.html": "Credits.html",
      "binaries/default.metallib": "default.metallib"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Camber",
    "longDescription": "Camber for desktop",
    "macOS": {
      "bundleName": "Camber",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
