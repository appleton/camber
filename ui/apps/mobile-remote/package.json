{
  "name": "@camber/mobile-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile remote-control web UI for the Camber desktop assistant, served by camber-helper over Tailscale.",
  "repository": {
    "type": "git",
    "url": "https://github.com/appleton/camber"
  },
  "author": {
    "name": "Andy Appleton",
    "url": "https://github.com/appleton"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:format": "prettier . --check --cache --ignore-path .gitignore --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "svelte-check --tsconfig tsconfig.json --fail-on-warnings --compiler-warnings \"state_referenced_locally:ignore,a11y_no_static_element_interactions:ignore\"",
    "dev": "vite --host 127.0.0.1",
    "dev:helper": "node scripts/dev-helper.mjs",
    "embed": "node scripts/embed-webui.mjs",
    "fix:format": "prettier . --write --cache --ignore-path .gitignore --ignore-path ../../.gitignore --list-different",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "prettier": "@camber/prettier-config",
  "dependencies": {
    "@camber/assistant": "workspace:*",
    "@camber/components": "workspace:*",
    "@camber/features": "workspace:*",
    "@camber/helperapi": "workspace:*",
    "@camber/lib": "workspace:*",
    "@camber/remote-client": "workspace:*",
    "@camber/rpc": "workspace:*"
  },
  "devDependencies": {
    "@camber/eslint-config": "workspace:*",
    "@camber/prettier-config": "workspace:*",
    "@camber/svelte-config": "workspace:*",
    "@camber/tailwind-config": "workspace:*",
    "@camber/tsconfig": "workspace:*",
    "@camber/vite-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
